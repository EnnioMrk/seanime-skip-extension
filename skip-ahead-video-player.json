{
    "id": "skip-ahead-video-player",
    "name": "Skip Ahead Video Player Button",
    "version": "1.1.1",
    "manifestURI": "https://raw.githubusercontent.com/EnnioMrk/seanime-skip-extension/refs/heads/main/skip-ahead-video-player.json",
    "language": "typescript",
    "type": "plugin",
    "description": "Adds a skip-ahead button to the video player control bar with configurable position. Useful for skipping intros or recaps in anime episodes.",
    "author": "Ennio",
    "icon": "https://raw.githubusercontent.com/EnnioMrk/seanime-skip-extension/refs/heads/main/icon.png",
    "website": "",
    "readme": "",
    "notes": "",
    "lang": "multi",
    "payload": "",
    "payloadURI": "https://raw.githubusercontent.com/EnnioMrk/seanime-skip-extension/refs/heads/main/skip-ahead-video-player.ts",
    "userConfig": {
        "version": 1,
        "requiresConfig": false,
        "fields": [
            {
                "type": "text",
                "name": "skipSeconds",
                "label": "Skip Ahead Seconds",
                "default": "85"
            },
            {
                "type": "select",
                "name": "buttonPosition",
                "label": "Button Position",
                "default": "after-next-episode",
                "options": [
                    {
                        "label": "After Next Episode Button",
                        "value": "after-next-episode"
                    },
                    {
                        "label": "After Play Button",
                        "value": "after-play-button"
                    },
                    {
                        "label": "After Episode Time Progress (Timestamp)",
                        "value": "after-timestamp"
                    }
                ]
            }
        ]
    },
    "plugin": {
        "version": "1",
        "permissions": {
            "scopes": ["playback"]
        }
    }
}
